# Live Sepolia KipuBankV3 (see https://github.com/DiegoNG90/KipuBankV3)
# Do not use the broken deploy 0x078dEbfbFC8C2764c561Bd636D833Cc569FDb3B2
NEXT_PUBLIC_KIPUBANK_ADDRESS=0xd8473b57CAdEd25D7b41b4c451e74C1Bf92DD3ca

# Sepolia RPC. Prefer Alchemy/Infura (same URL as the contract repo).
# rpc.sepolia.org often fails from the browser ("Failed to fetch").
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: first block to scan for on-chain history (reduces eth_getLogs load).
# Find it on Etherscan under the contract's creation transaction.
# NEXT_PUBLIC_KIPUBANK_DEPLOY_BLOCK=1234567
